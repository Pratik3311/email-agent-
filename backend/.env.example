APP_ENV=development

# URL of the standalone MCP server (see ../mcp/ — run it separately).
# The backend has NO database credentials; all data access goes through MCP.
MCP_SERVER_URL=http://127.0.0.1:8010/mcp

# Must match MCP_API_KEY in mcp/.env (sent as X-API-Key on every MCP call).
MCP_API_KEY=

OPENAI_API_KEY=
# Any OpenAI model that supports structured outputs
OPENAI_MODEL=gpt-4.1

# Pending approval plans expire after this many minutes
APPROVAL_TTL_MINUTES=30
