# No dedicated read-only Postgres role exists (policy blocks any server-side
# change to this database). This connects with the existing `clientintel`
# credentials; read-only is enforced entirely on this side — see the
# docstring on init_pool() in core/db.py for how.
# Real value goes only in your local .env, which is gitignored — do not put
# the real host/credentials here.
DATABASE_URL=postgresql://clientintel:CHANGE_ME@db-host:5433/clientintel

# Where the MCP server listens (Streamable HTTP endpoint will be /mcp)
MCP_HOST=127.0.0.1
MCP_PORT=8010

# API key clients must send (X-API-Key header). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match MCP_API_KEY in backend/.env. Empty = auth disabled (local dev
# on 127.0.0.1 only — NEVER leave empty on a reachable host).
MCP_API_KEY=

# Host header values to accept, comma-separated (DNS-rebinding protection).
# Leave empty for local dev (localhost only). When serving on a real host,
# set e.g.: MCP_ALLOWED_HOSTS=10.0.0.5:8010,my.server.com:*
MCP_ALLOWED_HOSTS=

# Defense-in-depth query limits
MAX_ROWS=100
QUERY_TIMEOUT_SECONDS=10
